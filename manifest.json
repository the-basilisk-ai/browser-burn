{
  "name": "BrowserBurn",
  "short_name": "BrowserBurn",
  "description": "Your browsing history has opinions about you. Now it shares them. A fresh, personalised roast on every new tab.",
  "version": "1.5.1",
  "author": "Squad",
  "minimum_chrome_version": "104",
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "manifest_version": 3,
  "host_permissions": [
    "https://ddzqz505u9.execute-api.eu-west-2.amazonaws.com/prod/burn",
    "https://nam5v7o2loht7eea6spgacrs640yhmaf.lambda-url.eu-west-2.on.aws/"
  ],
  "permissions": ["history", "storage"],
  "chrome_url_overrides": {
    "newtab": "src/newtab/index.html"
  }
}
